# Optional: choose where local settings, tokens, saved content, tasks, and snapshots are stored.
# Fresh installs use the operating system's per-user application-data directory.
# Existing installs with ./.control-center keep using it automatically. An absolute override is optional.
CONTROL_CENTER_DATA_DIR=

# Optional alternatives to saving provider keys in Settings -> AI curation.
# A provider is never called until that same provider is explicitly selected in Settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
